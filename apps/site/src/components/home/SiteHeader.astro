---
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
---

<header class="site-header">
  <a class="brand" href={base} aria-label="返回课程首页">
    <img
      class="brand-mark"
      src={withBase('brand/course-logo.svg')}
      alt=""
      aria-hidden="true"
      width="666"
      height="713"
    />
    <span class="brand-copy">
      <strong>大模型驱动的软件开发与测试</strong>
      <small>LLM-DRIVEN SOFTWARE DEVELOPMENT AND TESTING</small>
    </span>
  </a>
  <nav aria-label="主页章节导航">
    <a href="#course-info">课程信息</a>
    <a href="#core-goals">核心目标</a>
    <a href="#course-route">实验路线</a>
    <a href="#course-outcomes">课程收获</a>
    <a class="header-cta" href={withBase('getting-started/')}>开始学习</a>
  </nav>
</header>
