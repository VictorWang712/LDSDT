---
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
---

<header class="site-header">
  <a class="brand" href={base} aria-label="LDSDT 课程首页">
    <span class="brand-mark" aria-hidden="true">L</span>
    <span class="brand-copy">
      <strong>LDSDT</strong>
      <small>Software, directed by intelligence.</small>
    </span>
  </a>

  <nav aria-label="主要导航">
    <a href={withBase('course/overview/')}>实验总览</a>
    <a href={withBase('getting-started/')}>开始实验</a>
    <a href={withBase('resources/')}>资源</a>
  </nav>

  <a
    class="source-link"
    href="https://github.com/VictorWang712/LDSDT"
    target="_blank"
    rel="noreferrer"
  >
    GitHub <span aria-hidden="true">↗</span>
  </a>
</header>
