---
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const stages = [
  {
    number: '01',
    label: 'SPECIFY',
    title: '让需求与设计可执行',
    description:
      'Lab 1–2：构建需求分析与设计模块，把自然语言需求整理成规约、接口目录、模块设计与实现计划。',
    href: withBase('labs/lab-1/'),
  },
  {
    number: '02',
    label: 'BUILD · VERIFY',
    title: '让系统自主开发与测试',
    description:
      'Lab 3–4：构建实现与测试模块，生成可安装的仓库，再用测试结果驱动修复迭代。',
    href: withBase('labs/lab-3/'),
  },
  {
    number: '03',
    label: 'DELIVER',
    title: '在自拟的需求上检验系统',
    description: '期末：每组自己设计一个项目，交给本组系统生成可以安装使用的仓库。',
    href: withBase('labs/final/'),
  },
];
---

<section
  class="viewport-section stage-section"
  id="course-route"
  aria-labelledby="stage-heading"
>
  <div class="glass-surface stage-surface" data-reveal>
    <div class="section-index"><span>02</span><p>THE EXPERIMENTAL ARC</p></div>
    <div class="stage-content">
      <div class="stage-heading section-heading-copy">
        <p class="eyebrow">SPECIFY · BUILD · VERIFY</p><h2 id="stage-heading">
          八周递进，构建一套自主软件工程系统。
        </h2>
      </div>
      <ol class="stage-list">
        {
          stages.map((stage) => (
            <li class="stage-item">
              <a href={stage.href}>
                <span class="stage-label">{stage.label}</span>
                <>
                  <h3>{stage.title}</h3>
                  <p>{stage.description}</p>
                  <span class="stage-link">查看实验</span>
                </>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
