---
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const stages = [
  {
    number: '01',
    label: 'REPRESENT',
    title: '让需求与设计可执行',
    description:
      '构建运行时、需求 IR 与接口规约，把自然语言任务转化为机器可消费的工程产物。',
    href: withBase('labs/week-2/'),
  },
  {
    number: '02',
    label: 'ENGINEER',
    title: '让系统自主开发与测试',
    description: '实现代码生成、测试执行和调试修复，让反馈真正驱动软件仓库持续演化。',
    href: withBase('labs/week-4/'),
  },
  {
    number: '03',
    label: 'EVALUATE',
    title: '在未见任务上验证系统',
    description: '串联全部模块，以公开任务迭代、以私有任务检验端到端自主性与泛化能力。',
    href: withBase('labs/week-7/'),
  },
];
---

<section
  class="viewport-section stage-section"
  id="course-route"
  aria-labelledby="stage-heading"
>
  <div class="glass-surface stage-surface" data-reveal>
    <div class="section-index"><span>02</span><p>THE EXPERIMENTAL ARC</p></div>
    <div class="stage-content">
      <div class="stage-heading section-heading-copy">
        <p class="eyebrow">SPECIFY · BUILD · VERIFY</p><h2 id="stage-heading">
          八周递进，构建一套自主软件工程系统。
        </h2>
      </div>
      <ol class="stage-list">
        {
          stages.map((stage) => (
            <li class="stage-item">
              <a href={stage.href}>
                <span class="stage-label">{stage.label}</span>
                <>
                  <h3>{stage.title}</h3>
                  <p>{stage.description}</p>
                  <span class="stage-link">查看阶段说明</span>
                </>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
