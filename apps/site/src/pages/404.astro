---
import '../styles/fonts.css';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0a0d12" />
    <link rel="icon" href={withBase('favicon.svg')} />
    <title>页面未找到 · LDSDT</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: 'LXGW WenKai Screen', 'PingFang SC', 'Microsoft YaHei', sans-serif;
        background: #0a0d12;
        color: #f7f8fa;
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-height: 100vh;
        margin: 0;
        display: grid;
        place-items: center;
        background:
          radial-gradient(circle at 70% 20%, rgb(80 126 255 / 18%), transparent 36rem),
          #0a0d12;
      }

      main {
        width: min(680px, calc(100% - 3rem));
      }

      .code {
        margin: 0 0 1rem;
        color: #86a6ff;
        font:
          700 0.78rem/1 'Code New Roman NFM',
          Consolas,
          monospace;
        letter-spacing: 0.16em;
      }

      h1 {
        margin: 0;
        font-size: clamp(3rem, 9vw, 6rem);
        line-height: 0.96;
        letter-spacing: -0.06em;
      }

      p:not(.code) {
        max-width: 34rem;
        margin: 1.5rem 0 2rem;
        color: #aeb5c3;
        font-size: 1.05rem;
        line-height: 1.75;
      }

      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
      }

      a {
        display: inline-flex;
        align-items: center;
        min-height: 2.8rem;
        padding: 0 1.15rem;
        border: 1px solid #303846;
        border-radius: 999px;
        color: #f7f8fa;
        text-decoration: none;
      }

      a:first-child {
        border-color: #86a6ff;
        background: #86a6ff;
        color: #071023;
        font-weight: 700;
      }

      a:focus-visible {
        outline: 3px solid #f7f8fa;
        outline-offset: 3px;
      }
    </style>
  </head>
  <body>
    <main>
      <p class="code">ERROR / 404</p>
      <h1>页面未找到</h1>
      <p>
        这个地址可能已经改变，或者对应的课程材料尚未发布。你可以返回课程首页，或继续查看实验路线。
      </p>
      <nav aria-label="页面未找到后的导航">
        <a href={base}>返回课程首页</a>
        <a href={withBase('course/overview/')}>查看实验总览</a>
      </nav>
    </main>
  </body>
</html>
