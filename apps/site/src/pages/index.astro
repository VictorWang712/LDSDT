---
import SiteFooter from '../components/home/SiteFooter.astro';
import SiteHeader from '../components/home/SiteHeader.astro';
import StagePath from '../components/home/StagePath.astro';
import '../styles/home.css';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="大语言模型驱动的软件开发与测试实验课程：从模型部署、工具构建到应用交付。"
    />
    <meta name="theme-color" content="#0a0d12" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="canonical" href={new URL(base, Astro.site)} />
    <title>LDSDT · 大语言模型驱动的软件开发与测试</title>
  </head>
  <body>
    <div class="ambient-grid" aria-hidden="true"></div>
    <div class="page-shell">
      <SiteHeader />

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy" data-reveal>
            <p class="eyebrow">LLM-DRIVEN SOFTWARE ENGINEERING · EXPERIMENTAL COURSE</p>
            <h1 id="hero-title">让智能模型<br /><em>成为工程能力</em></h1>
            <p class="hero-lead">
              从国产大模型部署，到 AI Coding
              工具构建，再到真实应用交付。用三个相互衔接的阶段，完成一条可运行、可验证、可追踪的软件工程链路。
            </p>
            <div class="hero-actions">
              <a class="button button-primary" href={withBase('course/overview/')}>
                查看实验路线 <span aria-hidden="true">→</span>
              </a>
              <a class="button button-quiet" href={withBase('course/about/')}>了解课程</a>
            </div>
          </div>

          <div class="hero-system" aria-label="模型、工具与系统构成的工程闭环" data-reveal>
            <div class="system-orbit orbit-one"></div>
            <div class="system-orbit orbit-two"></div>
            <div class="system-core">
              <span>LLM</span>
              <small>ENGINEERING<br />LOOP</small>
            </div>
            <div class="system-node node-deploy">
              <span>01</span>
              <strong>MODEL</strong>
            </div>
            <div class="system-node node-build">
              <span>02</span>
              <strong>TOOL</strong>
            </div>
            <div class="system-node node-develop">
              <span>03</span>
              <strong>SYSTEM</strong>
            </div>
          </div>
        </section>

        <aside class="course-status" aria-label="课程建设状态" data-reveal>
          <span class="status-dot" aria-hidden="true"></span>
          <strong>课程材料持续建设中</strong>
          <p>
            当前网站先建立稳定的信息架构；实验细则、接口规范与评测方式将在确认后逐步发布。
          </p>
        </aside>

        <StagePath />

        <section class="principles" aria-labelledby="principles-heading">
          <div class="section-heading" data-reveal>
            <p class="eyebrow">ENGINEERING, NOT MAGIC</p>
            <h2 id="principles-heading">我们关心的不只是“能够生成代码”</h2>
          </div>
          <div class="principle-grid">
            <article data-reveal>
              <span>RUN</span>
              <h3>可运行</h3>
              <p>每个阶段都形成独立、清晰且能够复现的工程交付物。</p>
            </article>
            <article data-reveal>
              <span>VERIFY</span>
              <h3>可验证</h3>
              <p>用稳定接口与自动化测试，客观检验系统行为和质量。</p>
            </article>
            <article data-reveal>
              <span>TRACE</span>
              <h3>可追踪</h3>
              <p>保留关键过程和实验数据，为教学改进与后续研究提供依据。</p>
            </article>
          </div>
        </section>

        <section class="closing" data-reveal>
          <p class="eyebrow">START WITH THE COURSE</p>
          <h2>先把每一次实验，做成可靠的软件工程实践。</h2>
          <a class="button button-primary" href={withBase('getting-started/')}>
            开始阅读 <span aria-hidden="true">→</span>
          </a>
        </section>
      </main>

      <SiteFooter />
    </div>

    <script is:inline>
      document.documentElement.classList.add('motion-ready');

      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;

      if (prefersReducedMotion) {
        document.querySelectorAll('[data-reveal]').forEach((element) => {
          element.classList.add('is-visible');
        });
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.16 },
        );

        document.querySelectorAll('[data-reveal]').forEach((element) => {
          observer.observe(element);
        });
      }
    </script>
  </body>
</html>
