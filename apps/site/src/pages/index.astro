---
import SiteFooter from '../components/home/SiteFooter.astro';
import SiteHeader from '../components/home/SiteHeader.astro';
import StagePath from '../components/home/StagePath.astro';
import '../styles/home.css';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="大语言模型驱动的软件开发与测试实验课程：构建从自然语言需求到可执行代码仓库的自主软件工程系统。"
    />
    <meta name="theme-color" content="#050505" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="canonical" href={new URL(base, Astro.site)} />
    <title>CS3297M · 大语言模型驱动的软件开发与测试</title>
  </head>
  <body>
    <div class="cinematic-background" aria-hidden="true">
      <video autoplay muted loop playsinline preload="metadata">
        <source src={withBase('media/course-hero-background-mux.mp4')} type="video/mp4" />
      </video>
      <div class="video-shade"></div>
    </div>

    <SiteHeader />

    <main>
      <section class="opening" id="course-info" aria-labelledby="hero-title">
        <div class="opening-sticky">
          <div class="opening-meta">
            <p>ZHEJIANG UNIVERSITY · CS3297M</p>
            <span>2026–2027 · WINTER SEMESTER</span>
          </div>
          <div class="opening-curtain opening-curtain-left" aria-hidden="true">
            <div class="curtain-copy curtain-copy-left">
              LLM-DRIVEN SOFTWARE DEVELOPMENT AND TESTING
            </div>
          </div>
          <div class="opening-curtain opening-curtain-right" aria-hidden="true">
            <div class="curtain-copy curtain-copy-right">
              LLM-DRIVEN SOFTWARE DEVELOPMENT AND TESTING
            </div>
          </div>
          <div class="hero-reveal course-information">
            <p class="eyebrow">CS3297M · COURSE INFORMATION</p>
            <h1 id="hero-title">大模型驱动的<br />软件开发与测试</h1>
            <p class="course-english-name">LLM-DRIVEN SOFTWARE DEVELOPMENT AND TESTING</p>
            <dl class="course-facts">
              <div><dt>学期</dt><dd>2026–2027 学年冬学期</dd></div>
              <div>
                <dt>教师</dt><dd><a href="https://xin-xia.github.io/">夏鑫 教授</a></dd>
              </div>
              <div>
                <dt>助教</dt><dd><a href="https://victorwang712.github.io/">王殊凡</a></dd>
              </div>
            </dl>
          </div>
          <div class="scroll-cue" aria-hidden="true">
            <span>SCROLL TO OPEN</span><i></i>
          </div>
        </div>
      </section>

      <section
        class="viewport-section manifesto"
        id="core-goals"
        aria-labelledby="manifesto-title"
      >
        <div class="glass-surface manifesto-surface" data-reveal>
          <div class="section-index"><span>01</span><p>CORE OBJECTIVE</p></div>
          <div class="manifesto-copy">
            <div class="section-heading-copy">
              <p class="eyebrow">A NEW SOFTWARE ENGINEERING PARADIGM</p>
              <h2 id="manifesto-title">把软件工程方法变成可执行的智能系统。</h2>
            </div>
            <div class="principle-line" aria-label="课程核心目标">
              <article>
                <span>HUMAN–AI COLLABORATION</span><h3>人机协同</h3><p>
                  不只使用 AI 编程，而是设计需求、开发、测试与修复之间的协作机制。
                </p>
              </article>
              <article>
                <span>INTELLIGENT WORKFLOW</span><h3>流程重构</h3><p>
                  用 IR、规约、接口和测试重组软件过程，让工程知识能够被 Agent 消费。
                </p>
              </article>
              <article>
                <span>RESPONSIBLE ENGINEERING</span><h3>可靠交付</h3><p>
                  让自主系统以可追踪、可复现的方式交付可构建、可运行的软件仓库。
                </p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <StagePath />

      <section
        class="viewport-section standards"
        id="course-outcomes"
        aria-labelledby="standards-title"
      >
        <div class="glass-surface standards-surface" data-reveal>
          <div class="section-index"><span>03</span><p>LEARNING OUTCOMES</p></div>
          <div class="standards-copy">
            <div class="section-heading-copy">
              <p class="eyebrow">WHAT WILL YOU GAIN?</p>
              <h2 id="standards-title">通过学习这门课，你会收获什么？</h2>
            </div>
            <div class="standard-list">
              <article>
                <span>EXECUTABLE METHODOLOGY</span><h3>系统设计</h3><p>
                  将需求、架构、实现、测试和修复方法编码为端到端自主系统。
                </p>
              </article>
              <article>
                <span>AI-NATIVE ENGINEERING</span><h3>工程能力</h3><p>
                  掌握 IR、DSL、Spec、契约、测试反馈与 Agent 协作等关键方法。
                </p>
              </article>
              <article>
                <span>EVIDENCE-BASED EVALUATION</span><h3>验证能力</h3><p>
                  用独立测试、执行轨迹和私有任务判断自主系统的真实能力与边界。
                </p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section class="viewport-section closing" aria-labelledby="closing-title">
        <div class="closing-copy" data-reveal>
          <p class="eyebrow">BEGIN THE EXPERIMENT</p>
          <h2 id="closing-title">让我们从这里开始吧。</h2>
          <p class="closing-lead">从最小运行时开始，构建能够自主交付软件的工程系统。</p>
          <a class="button button-primary" href={withBase('getting-started/')}>开始学习</a>
        </div>
        <SiteFooter />
      </section>
    </main>

    <script is:inline>
      document.documentElement.classList.add('motion-ready');

      const scroller = document.querySelector('main');
      const pages = Array.from(scroller?.querySelectorAll(':scope > section') ?? []);
      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;
      let activePage = 0;
      let portalOpen = prefersReducedMotion;
      let transitionLocked = false;
      let touchStartY = 0;

      const setPortal = (open) => {
        portalOpen = open;
        document.documentElement.classList.toggle('portal-open', open);
      };

      const lockTransition = (duration = 900) => {
        transitionLocked = true;
        window.setTimeout(() => {
          transitionLocked = false;
        }, duration);
      };

      const goToPage = (index) => {
        const target = Math.min(Math.max(index, 0), pages.length - 1);
        if (target === activePage || !pages[target]) return;
        activePage = target;
        pages[target].scrollIntoView({
          behavior: prefersReducedMotion ? 'auto' : 'smooth',
          block: 'start',
        });
        lockTransition(prefersReducedMotion ? 100 : 900);
      };

      const step = (direction) => {
        if (transitionLocked || !direction) return;
        if (activePage === 0 && direction > 0 && !portalOpen) {
          setPortal(true);
          lockTransition(prefersReducedMotion ? 100 : 950);
          return;
        }
        if (activePage === 0 && direction < 0 && portalOpen) {
          setPortal(false);
          lockTransition(prefersReducedMotion ? 100 : 950);
          return;
        }
        goToPage(activePage + direction);
      };

      scroller?.addEventListener(
        'wheel',
        (event) => {
          if (Math.abs(event.deltaY) < 8) return;
          event.preventDefault();
          step(event.deltaY > 0 ? 1 : -1);
        },
        { passive: false },
      );

      scroller?.addEventListener(
        'touchstart',
        (event) => {
          touchStartY = event.changedTouches[0]?.clientY ?? 0;
        },
        { passive: true },
      );

      scroller?.addEventListener(
        'touchend',
        (event) => {
          const distance = touchStartY - (event.changedTouches[0]?.clientY ?? touchStartY);
          if (Math.abs(distance) > 42) step(distance > 0 ? 1 : -1);
        },
        { passive: true },
      );

      addEventListener('keydown', (event) => {
        if (['ArrowDown', 'PageDown', ' '].includes(event.key)) {
          event.preventDefault();
          step(1);
        } else if (['ArrowUp', 'PageUp'].includes(event.key)) {
          event.preventDefault();
          step(-1);
        }
      });

      document.querySelectorAll('a[href^="#"]').forEach((link) => {
        link.addEventListener('click', (event) => {
          const target = document.querySelector(link.getAttribute('href'));
          const index = pages.indexOf(target);
          if (index < 0) return;
          event.preventDefault();
          activePage = index;
          if (index === 0) setPortal(true);
          target.scrollIntoView({
            behavior: prefersReducedMotion ? 'auto' : 'smooth',
            block: 'start',
          });
          lockTransition(prefersReducedMotion ? 100 : 900);
        });
      });

      const pageObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && entry.intersectionRatio > 0.7)
              activePage = pages.indexOf(entry.target);
          });
        },
        { root: scroller, threshold: [0.7] },
      );
      pages.forEach((page) => pageObserver.observe(page));

      if (prefersReducedMotion) setPortal(true);

      if (prefersReducedMotion) {
        document
          .querySelectorAll('[data-reveal]')
          .forEach((element) => element.classList.add('is-visible'));
      } else {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
            });
          },
          { root: scroller, threshold: 0.32 },
        );
        document
          .querySelectorAll('[data-reveal]')
          .forEach((element) => revealObserver.observe(element));
      }
    </script>
  </body>
</html>
