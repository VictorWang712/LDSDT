{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ldsdt:contracts:stage-1:deployment-credential:v1",
  "title": "LDSDT stage-one deployment credential",
  "description": "Signed, endpoint-independent proof that one team passed stage-one deployment evaluation for an immutable source revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "credential_type",
    "credential_id",
    "deployment_id",
    "issuer",
    "subject",
    "source",
    "model",
    "platform",
    "evaluation",
    "issued_at",
    "proof"
  ],
  "properties": {
    "schema_version": {
      "const": "ldsdt.credential/v1"
    },
    "credential_type": {
      "const": "model_deployment"
    },
    "credential_id": {
      "$ref": "#/$defs/identifier"
    },
    "deployment_id": {
      "$ref": "#/$defs/identifier"
    },
    "issuer": {
      "type": "string",
      "format": "uri"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "platform": {
      "$ref": "#/$defs/platform"
    },
    "evaluation": {
      "$ref": "#/$defs/evaluation"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revocation_endpoint": {
      "type": "string",
      "format": "uri"
    },
    "proof": {
      "$ref": "#/$defs/proof"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team_id"],
      "properties": {
        "team_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "manifest_sha256"],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id"],
      "properties": {
        "registry_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform_class",
        "allocation_id",
        "attestation_id",
        "local_inference_observed",
        "prohibited_external_api_observed"
      ],
      "properties": {
        "platform_class": {
          "$ref": "#/$defs/identifier"
        },
        "allocation_id": {
          "$ref": "#/$defs/identifier"
        },
        "attestation_id": {
          "$ref": "#/$defs/identifier"
        },
        "local_inference_observed": {
          "const": true
        },
        "prohibited_external_api_observed": {
          "const": false
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "protocol", "result"],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/identifier"
        },
        "protocol": {
          "const": "ldsdt.model-service/v1"
        },
        "result": {
          "const": "passed"
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "verification_method",
        "created",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "canonicalization": {
          "const": "RFC8785"
        },
        "verification_method": {
          "type": "string",
          "format": "uri-reference"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "value": {
          "description": "Base64url-encoded Ed25519 signature over the RFC 8785 canonical form of the credential with the proof.value field omitted.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}
