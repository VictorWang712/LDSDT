{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ldsdt:contracts:stage-1:evaluation-result:v1",
  "title": "LDSDT stage-one evaluation result",
  "description": "Machine-readable status, test results, evidence summary, metrics, and student-facing feedback for one immutable evaluation run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "submitted_at",
    "submission",
    "results",
    "feedback"
  ],
  "properties": {
    "schema_version": {
      "const": "ldsdt.evaluation-result/v1"
    },
    "run_id": {
      "$ref": "#/$defs/identifier"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "queued",
        "preparing",
        "starting",
        "testing",
        "passed",
        "failed",
        "infra_error"
      ]
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "submission": {
      "$ref": "#/$defs/submission"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/testResult"
      }
    },
    "evidence_summary": {
      "$ref": "#/$defs/evidenceSummary"
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "feedback": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feedback"
      }
    },
    "deployment_id": {
      "$ref": "#/$defs/identifier"
    },
    "credential_id": {
      "$ref": "#/$defs/identifier"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": [
          "started_at",
          "completed_at",
          "evidence_summary",
          "deployment_id",
          "credential_id"
        ],
        "properties": {
          "results": {
            "type": "array",
            "minItems": 1,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/testResult"
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "passed"
                    }
                  },
                  "required": ["status"]
                }
              ]
            }
          },
          "evidence_summary": {
            "allOf": [
              {
                "$ref": "#/$defs/evidenceSummary"
              },
              {
                "type": "object",
                "properties": {
                  "local_inference_observed": {
                    "const": true
                  },
                  "prohibited_external_api_observed": {
                    "const": false
                  }
                },
                "required": [
                  "local_inference_observed",
                  "prohibited_external_api_observed"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["failed", "infra_error"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["started_at", "completed_at"]
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team_id",
        "repository",
        "commit",
        "manifest_path",
        "manifest_sha256",
        "allocation_id"
      ],
      "properties": {
        "team_id": {
          "$ref": "#/$defs/identifier"
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "manifest_path": {
          "type": "string",
          "const": "ldsdt.yaml"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "allocation_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_id", "category", "visibility", "status"],
      "properties": {
        "test_id": {
          "type": "string",
          "pattern": "^(PKG|ENV|LIFE|API|INF|STB|ATT|LINK)-[0-9]{3}$"
        },
        "category": {
          "type": "string",
          "enum": [
            "package",
            "environment",
            "lifecycle",
            "api",
            "inference",
            "stability",
            "attestation",
            "linkage"
          ]
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "private"]
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "not_run", "infra_error"]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "error_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      }
    },
    "evidenceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation_id",
        "platform_class",
        "local_inference_observed",
        "prohibited_external_api_observed"
      ],
      "properties": {
        "attestation_id": {
          "$ref": "#/$defs/identifier"
        },
        "platform_class": {
          "$ref": "#/$defs/identifier"
        },
        "accelerator_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "local_inference_observed": {
          "type": "boolean"
        },
        "prohibited_external_api_observed": {
          "type": "boolean"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prepare_ms": {
          "type": "integer",
          "minimum": 0
        },
        "startup_ms": {
          "type": "integer",
          "minimum": 0
        },
        "time_to_first_token_ms": {
          "type": "number",
          "minimum": 0
        },
        "output_tokens_per_second": {
          "type": "number",
          "minimum": 0
        },
        "peak_accelerator_memory_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "documentation": {
          "type": "string",
          "format": "uri-reference"
        }
      }
    }
  }
}
